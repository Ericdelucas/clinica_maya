<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.AppDaMaya" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/maya_accent_strong</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/maya_accent</item>
        <item name="android:statusBarColor">@color/maya_accent_strong</item>
        <item name="android:navigationBarColor">@color/maya_bg</item>
        <item name="android:windowBackground">@color/maya_bg</item>
        <item name="android:colorBackground">@color/maya_bg</item>
        <item name="colorSurface">@color/maya_bg_elevated</item>
        <item name="colorOnSurface">@color/maya_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.AppDaMaya" parent="Base.Theme.AppDaMaya" />

    <style name="Widget.Maya.Tab" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/maya_text_muted</item>
        <item name="backgroundTint">@color/maya_bg_panel</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.Maya.Tab.Active">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/maya_accent_strong</item>
    </style>
</resources>

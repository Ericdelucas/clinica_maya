<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/maya_bg" tools:context=".TelaPainelFragment">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <include
            android:id="@+id/includeTopbar"
            layout="@layout/componente_cabecalho" />
        <TextView
            android:id="@+id/bannerMannequin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner"
            android:padding="10dp"
            android:textColor="@color/maya_accent_deep"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Boneco de Ana · 3 vídeo(s) próprio(s)"
            tools:visibility="visible" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <include
                android:id="@+id/includeMannequin"
                layout="@layout/tela_boneco_3d"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <include
                android:id="@+id/includePanelPro"
                layout="@layout/painel_profissional"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <include
                android:id="@+id/includePanelPaciente"
                layout="@layout/painel_paciente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <include
                android:id="@+id/includeCalendar"
                layout="@layout/tela_calendario"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/mobileSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginTop="8dp" android:background="@drawable/bg_switch" android:orientation="horizontal" android:padding="4dp" android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/buttonMannequinTab"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/nav_mannequin"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:textSize="12sp"
                android:backgroundTint="@null"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/buttonPanelTab"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/nav_panel"
                android:textAllCaps="false"
                android:textColor="@color/maya_text_muted"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:textSize="12sp"
                android:backgroundTint="@null"
                app:backgroundTint="@null" />
            <Button
                android:id="@+id/buttonCalendarTab"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab"
                android:text="@string/tab_calendar"
                android:textAllCaps="false"
                android:textColor="@color/maya_text_muted"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:textSize="12sp"
                android:backgroundTint="@null"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
    <include
        android:id="@+id/includeCredentials"
        layout="@layout/dialogo_alterar_acesso"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
    <TextView
        android:id="@+id/textToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="20dp"
        android:background="@drawable/bg_toast"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="@color/white"
        android:visibility="gone"
        tools:text="Boneco aberto"
        tools:visibility="visible" />
</FrameLayout>

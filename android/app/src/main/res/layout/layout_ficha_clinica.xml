<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ficha_title"
        android:textColor="@color/maya_text"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:text="@string/ficha_lead"
        android:textColor="@color/maya_text_muted" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_full_name"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputFullName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_full_name"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_birth"
                android:textColor="@color/maya_text_muted"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_birth"
                android:inputType="date"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_phone"
                android:textColor="@color/maya_text_muted"
                android:textStyle="bold" />
            <EditText
                android:id="@+id/inputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_phone"
                android:inputType="phone"
                android:minHeight="48dp"
                android:paddingHorizontal="10dp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_psychotherapy"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/spinnerPsychotherapy"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="8dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_activity"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/hint_activity"
        android:minHeight="48dp"
        android:paddingHorizontal="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_health"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_health"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_meds"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputMeds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_meds"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_surgeries"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputSurgeries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_surgeries"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_pain"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputPain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_pain"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_complaint"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputComplaint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_complaint"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_notes"
        android:textColor="@color/maya_text_muted"
        android:textStyle="bold" />
    <EditText
        android:id="@+id/inputFichaNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:gravity="top"
        android:hint="@string/hint_notes"
        android:inputType="textMultiLine"
        android:minHeight="80dp"
        android:padding="14dp" />
    <Button
        android:id="@+id/buttonSaveFicha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_primary"
        android:text="@string/action_save_ficha"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:backgroundTint="@null"
        app:backgroundTint="@null" />
</LinearLayout>

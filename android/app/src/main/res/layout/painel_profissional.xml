<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/panel_pro_title" android:textColor="@color/maya_accent_deep" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/panel_pro_lead" android:textColor="@color/maya_text_muted" android:textSize="13sp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/tabPacientes" android:layout_width="wrap_content" android:layout_height="48dp" android:background="@drawable/bg_tab" android:text="@string/tab_patients" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/tabArticulacoes" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_tab" android:text="@string/tab_joints" android:textAllCaps="false" android:textColor="@color/maya_text_muted" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/tabCadastrar" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_tab" android:text="@string/tab_register" android:textAllCaps="false" android:textColor="@color/maya_text_muted" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/tabExames" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_tab" android:text="@string/tab_exams" android:textAllCaps="false" android:textColor="@color/maya_text_muted" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/tabVisao" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="6dp" android:background="@drawable/bg_tab" android:text="@string/tab_vision" android:textAllCaps="false" android:textColor="@color/maya_text_muted" android:backgroundTint="@null" app:backgroundTint="@null" />
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/contentPacientes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/patients_title" android:textColor="@color/maya_text" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/bg_stat" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_patients" android:textColor="@color/maya_text_muted" />
                    <TextView android:id="@+id/textPatientCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/maya_accent_deep" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_stat" android:orientation="vertical" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stat_mannequins" android:textColor="@color/maya_text_muted" />
                    <TextView android:id="@+id/textMannequinCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/maya_accent_deep" android:textSize="22sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/patients_hint" android:textColor="@color/maya_text_muted" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/label_search" android:textColor="@color/maya_text_muted" android:textStyle="bold" />
            <EditText android:id="@+id/inputSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="@string/hint_search" android:inputType="text" android:minHeight="48dp" android:paddingHorizontal="14dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/listPatients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" tools:itemCount="2" tools:listitem="@layout/item_paciente" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contentArticulacoes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/videos_title" android:textColor="@color/maya_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/video_patient_label" android:textStyle="bold" android:layout_marginTop="12dp" android:textColor="@color/maya_text" />
            <Spinner android:id="@+id/spinnerVideoPatient" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:background="@drawable/bg_input" android:paddingHorizontal="12dp" />
            <Button android:id="@+id/buttonPatientPreview" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/preview_patient_videos" android:textAllCaps="false" android:background="@drawable/bg_btn_ghost" android:textColor="@color/maya_accent_deep" android:backgroundTint="@null" app:backgroundTint="@null" />
            <TextView android:id="@+id/textVideosHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/videos_empty" android:textColor="@color/maya_danger" />
            <TextView android:id="@+id/textSelectedJoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/no_joint" android:textColor="@color/maya_accent_deep" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/textJointOrientation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/joint_orientation_hint" android:textColor="@color/maya_text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/label_youtube" android:textColor="@color/maya_text_muted" android:textStyle="bold" />
            <EditText android:id="@+id/inputYoutube" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_input" android:hint="@string/hint_youtube" android:inputType="textUri" android:minHeight="48dp" android:paddingHorizontal="14dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical">
                <Button android:id="@+id/buttonOpenVideo" android:layout_width="match_parent" android:layout_height="44dp" android:background="@drawable/bg_btn_ghost" android:text="@string/action_open_video" android:textAllCaps="false" android:textColor="@color/maya_accent_deep" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/buttonClearVideo" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:background="@drawable/bg_btn_ghost" android:text="@string/action_clear_video" android:textAllCaps="false" android:textColor="@color/maya_accent_deep" android:backgroundTint="@null" app:backgroundTint="@null" />
                <Button android:id="@+id/buttonSaveVideo" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/bg_btn_primary" android:text="@string/action_save_video" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@null" app:backgroundTint="@null" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/other_regions" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/maya_text" />
            <GridLayout android:id="@+id/gridJoints" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:columnCount="2" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contentCadastrar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/register_title" android:textColor="@color/maya_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/register_lead" android:textColor="@color/maya_text_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/label_name" android:textColor="@color/maya_text_muted" android:textStyle="bold" />
            <EditText android:id="@+id/inputPatientName" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="textPersonName" android:minHeight="48dp" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/label_email" android:textColor="@color/maya_text_muted" android:textStyle="bold" />
            <EditText android:id="@+id/inputPatientEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="textEmailAddress" android:minHeight="48dp" android:paddingHorizontal="14dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/label_temp_password" android:textColor="@color/maya_text_muted" android:textStyle="bold" />
            <EditText android:id="@+id/inputPatientPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="text" android:minHeight="48dp" android:paddingHorizontal="14dp" />
            <TextView android:id="@+id/textRegisterMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" />
            <Button android:id="@+id/buttonRegisterPatient" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:background="@drawable/bg_btn_primary" android:text="@string/action_register" android:textAllCaps="false" android:textColor="@color/white" android:backgroundTint="@null" app:backgroundTint="@null" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contentExamesPro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/exams_pro_title" android:textColor="@color/maya_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/exams_pro_lead" android:textColor="@color/maya_text_muted" />
            <TextView android:id="@+id/textExamsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/exams_empty" android:textColor="@color/maya_text_muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/contentVisao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_accent" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="@string/vision_badge" android:textColor="@color/white" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/vision_title" android:textColor="@color/maya_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/vision_lead" android:textColor="@color/maya_text_muted" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/vision_tip_1" android:textColor="@color/maya_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/vision_tip_2" android:textColor="@color/maya_text" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/vision_tip_3" android:textColor="@color/maya_text" />
            <Button android:id="@+id/buttonCloseVision" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp" android:background="@drawable/bg_btn_ghost" android:text="@string/vision_close" android:textAllCaps="false" android:textColor="@color/maya_accent_deep" android:backgroundTint="@null" app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>